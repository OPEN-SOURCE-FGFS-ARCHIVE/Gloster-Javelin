<?xml version="1.0" encoding="utf-8"?>

<PropertyList>

<filter>
  <name>IdlePitch</name>
  <debug>false</debug>
  <type>gain</type>
  <gain>1.0</gain>
  <input>
    <expression>
      <table>
        <property>engines/engine[0]/thrust-lbs</property>
          <entry><ind>0.0</ind><dep>0.0</dep></entry>
          <entry><ind>3000.0</ind><dep>0.5</dep></entry>
          <entry><ind>8000.0</ind><dep>0.8</dep></entry>
      </table>
    </expression>
  </input>
  <output>
    <property>sound/idle-pitch</property>
  </output>
</filter>

<filter>
  <name>IdleGain</name>
  <debug>false</debug>
