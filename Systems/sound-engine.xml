        <property>engines/engine[0]/thrust-lbs</property>
          <entry><ind>0.0</ind><dep>1.0</dep></entry>
          <entry><ind>3000.0</ind><dep>1.0</dep></entry>
          <entry><ind>8000.0</ind><dep>0.0</dep></entry>
      </table>
    </expression>
  </input>
  <output>
    <property>sound/idle-gain</property>
  </output>
</filter>

