<?xml version="1.0"?>

<PropertyList>

    <fx>
	
        <!-- EXTERNAL ENGINE -->

        <engine>
            <name>engine-idle-external</name>
            <path>Aircraft/Gloster-Javelin/Sounds/geed/harrier_idle_external_mono.wav</path>
            <mode>looped</mode>
            <condition>
                    <equals>
                        <property>/sim/current-view/internal</property>
                        <value>0</value>
                    </equals>
            </condition>
            <volume>
                <property>sound/idle-gain</property>
            </volume>
            <pitch>
                <property>sound/idle-pitch</property>
                <factor>1.0</factor>
                <min>0.0</min>
                <max>1.8</max>
            </pitch>
            <position>
                <x>7.0</x>
                <y>0.0</y>
                <z>0</z>
            </position>
            <reference-dist>15</reference-dist>
            <max-dist>200</max-dist>
        </engine>

        <engine>
            <name>engine-whine</name>
            <path>Aircraft/Gloster-Javelin/Sounds/geed/harrier_idle_external_front_mono.wav</path>
            <mode>looped</mode>
            <condition>
                    <equals>
                        <property>/sim/current-view/internal</property>
                        <value>0</value>
                    </equals>
            </condition>
            <volume>
                <property>sound/idle-gain</property>
            </volume>
            <pitch>
                <property>sound/idle-pitch-whine</property>
                <factor>1.0</factor>
                <min>0.0</min>
                <max>1.8</max>
            </pitch>
            <orientation>
                <x>-1.0</x>
                <y>0.0</y>
                <z>0</z>
                <inner-angle>70.0</inner-angle>
                <outer-angle>190</outer-angle>
                <outer-gain>0.15</outer-gain>
            </orientation>
            <position>
                <x>7.0</x>
                <y>0.0</y>
                <z>0</z>
            </position>
            <reference-dist>15</reference-dist>
            <max-dist>200</max-dist>
        </engine>

        <engine>
            <name>engine-full</name>
            <path>Aircraft/Gloster-Javelin/Sounds/geed/harrier_full_external_closerange_mono.wav</path>
            <mode>looped</mode>
            <condition>
                    <equals>
                        <property>/sim/current-view/internal</property>
                        <value>0</value>
                    </equals>
            </condition>
            <volume>
                <property>sound/full-gain</property>
            </volume>
            <pitch>
                <property>sound/full-pitch</property>
                <factor>1.0</factor>
                <min>-0.3</min>
                <max>1.0</max>
            </pitch>
            <position>
                <x>7.0</x>
                <y>0.0</y>
                <z>0</z>
            </position>
            <reference-dist>25</reference-dist>
            <max-dist>500</max-dist>
        </engine>

        <engine>
            <name>engine-compression</name>
            <path>Aircraft/Gloster-Javelin/Sounds/geed/harrier_compression_compressed_external.wav</path>
            <mode>looped</mode>
            <condition>
                    <equals>
                        <property>/sim/current-view/internal</property>
                        <value>0</value>
                    </equals>
            </condition>
            <volume>
                <property>sound/distant-full-gain</property>
            </volume>
            <position>
                <x>7.0</x>
                <y>0.0</y>
                <z>0</z>
            </position>
            <reference-dist>25</reference-dist>
            <max-dist>2500</max-dist>
        </engine>

        <engine>
            <name>engine-ab-bass</name>
            <path>Aircraft/Gloster-Javelin/Sounds/geed/harrier_idle_internal_bass_mono.wav</path>
            <mode>looped</mode>
            <volume>
                <property>sound/ab-gain</property>
            </volume>
            <position>
                <x>7.0</x>
                <y>0.0</y>
                <z>0.0</z>
            </position>
            <reference-dist>25</reference-dist>
            <max-dist>800</max-dist>
        </engine>







        <!-- INTERNAL ENGINE -->

        <engine-internal>
            <name>engine-idle-internal-left</name>
            <path>Aircraft/Gloster-Javelin/Sounds/geed/harrier_idle_internal_mono_left.wav</path>
            <mode>looped</mode>
            <condition>
                    <equals>
                        <property>/sim/current-view/internal</property>
                        <value>1</value>
                    </equals>
            </condition>
            <volume>
                <property>sound/idle-gain</property>
                <factor>0.5</factor>
            </volume>
            <volume>
                <value>0.5</value>
            </volume>
            <pitch>
                <property>sound/idle-pitch</property>
                <factor>1.0</factor>
                <min>0.0</min>
                <max>1.8</max>
            </pitch>
            <position>
                <x>2.0</x>
                <y>-2.0</y>
                <z>0.0</z>
            </position>
        </engine-internal>
        <engine-internal>
            <name>engine-idle-internal-right</name>
            <path>Aircraft/Gloster-Javelin/Sounds/geed/harrier_idle_internal_mono_right.wav</path>
            <mode>looped</mode>
            <condition>
                    <equals>
                        <property>/sim/current-view/internal</property>
                        <value>1</value>
                    </equals>
            </condition>
            <volume>
                <property>sound/idle-gain</property>
                <factor>0.5</factor>
            </volume>
            <volume>
                <value>0.5</value>
            </volume>
            <pitch>
                <property>sound/idle-pitch</property>
                <factor>1.0</factor>
                <min>0.0</min>
                <max>1.8</max>
            </pitch>
            <position>
                <x>2.0</x>
                <y>2.0</y>
                <z>0.0</z>
            </position>
        </engine-internal>

        <engine-internal>
            <name>engine-full-internal-left</name>
            <path>Aircraft/Gloster-Javelin/Sounds/geed/full_power_internal_mono_left.wav</path>
            <mode>looped</mode>
            <condition>
                    <equals>
                        <property>/sim/current-view/internal</property>
                        <value>1</value>
                    </equals>
            </condition>
            <volume>
                <property>sound/full-gain-internal</property>
            </volume>
            <pitch>
                <property>sound/full-pitch</property>
                <factor>1.0</factor>
                <min>-0.3</min>
                <max>1.0</max>
            </pitch>
            <position>
                <x>2.0</x>
                <y>-2.0</y>
                <z>0.0</z>
            </position>
        </engine-internal>
        <engine-internal>
            <name>engine-full-internal-right</name>
            <path>Aircraft/Gloster-Javelin/Sounds/geed/full_power_internal_mono_right.wav</path>
            <mode>looped</mode>
            <condition>
                    <equals>
                        <property>/sim/current-view/internal</property>
                        <value>1</value>
                    </equals>
            </condition>
            <volume>
                <property>sound/full-gain-internal</property>
            </volume>
            <pitch>
                <property>sound/full-pitch</property>
                <factor>1.0</factor>
                <min>-0.3</min>
                <max>1.0</max>
            </pitch>
            <position>
                <x>2.0</x>
                <y>2.0</y>
                <z>0.0</z>
            </position>
        </engine-internal>


        <buffet>
           <name>alpha-buffet</name>
           <mode>looped</mode>
           <condition>
                <and>
                    <greater-than>
                        <property>orientation/alpha-deg</property>
                        <value>5</value>
                    </greater-than>
                    <equals>
                        <property>/sim/current-view/internal</property>
                        <value>1</value>
                    </equals>
                </and>   
           </condition>
           <volume>
                <value>2</value>
            </volume>
           <path>Aircraft/Gloster-Javelin/Sounds/geed/gforce_rumble.wav</path>
        </buffet>

    </fx>

</PropertyList>